\name{ls_reset_window_layout}
\alias{ls_reset_window_layout}
\alias{ls_tile_windows}
\title{Reset or tile native LinkEDA windows}
\usage{
ls_reset_window_layout()
ls_tile_windows()
}
\description{
Resets the native workbench window placement cursor. New graph windows are then
placed from the top-left of the main screen, moving right and wrapping to the
next row.
}
\value{Invisibly returns \code{TRUE}.}
