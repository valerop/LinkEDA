\name{ls_new_contingency_table}
\alias{ls_new_contingency_table}
\title{Open a linked contingency table}
\usage{ls_new_contingency_table(group = NULL, row, column)}
\arguments{
\item{group}{Registered dataset or dataset group name.}
\item{row}{Row variable name.}
\item{column}{Column variable name.}
}
\value{Invisibly returns \code{TRUE} after opening the native table.}
\description{Opens a native contingency table using the current LinkEDA analysis scope.}
