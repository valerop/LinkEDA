<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LinkEDA.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- One application-wide UI typeface. WinUI controls, menus,
                 ContentDialogs, data sheets and output views inherit this
                 theme resource while Windows keeps handling DPI scaling. -->
            <FontFamily x:Key="LinkEDAInterfaceFontFamily">Segoe UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
            <x:Double x:Key="LinkEDAInterfaceFontSize">12.5</x:Double>
            <x:Double x:Key="ControlContentThemeFontSize">12.5</x:Double>
            <x:Double x:Key="LinkEDASpaceUnit">4</x:Double>
            <x:Double x:Key="LinkEDACommonSpacing">8</x:Double>
            <x:Double x:Key="LinkEDADialogPadding">16</x:Double>
            <x:Double x:Key="LinkEDACompactControlHeight">30</x:Double>
            <x:Double x:Key="LinkEDAVariableRowHeight">27</x:Double>
            <Thickness x:Key="LinkEDACompactControlPadding">10,3,10,3</Thickness>
            <!-- Desktop-density menus. These values are device-independent
                 pixels, so Windows still applies per-monitor DPI scaling. -->
            <x:Double x:Key="MenuFlyoutThemeMinHeight">28</x:Double>
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">0,1</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePadding">10,4,10,4</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">10,3,10,3</Thickness>
            <Thickness x:Key="MenuFlyoutSeparatorThemePadding">10,2</Thickness>
            <Thickness x:Key="MenuFlyoutItemMargin">3,0</Thickness>
            <Thickness x:Key="MenuBarItemButtonPadding">9,3</Thickness>
            <Thickness x:Key="MenuBarItemMargin">1</Thickness>
            <Style x:Key="LinkEDACompactButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="14,3" />
            </Style>
            <Style x:Key="LinkEDACompactComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
            <Style x:Key="LinkEDACompactTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,3" />
            </Style>
            <Style x:Key="LinkEDAVariableListStyle" TargetType="ListView">
                <Setter Property="IsMultiSelectCheckBoxEnabled" Value="False" />
                <Setter Property="SelectionMode" Value="Extended" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
